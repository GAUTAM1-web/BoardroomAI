POSTGRES_USER=boardroom
POSTGRES_PASSWORD=boardroom_dev_password
DATABASE_URL=postgresql+asyncpg://boardroom:boardroom_dev_password@postgres:5432/boardroom_ai

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

BUSINESS_DATA_MODE=demo
MAPS_PROVIDER=osm_nominatim
PLACES_PROVIDER=osm_nominatim
WEATHER_PROVIDER=open_meteo
NEWS_PROVIDER=gdelt_doc
CURRENCY_PROVIDER=frankfurter
