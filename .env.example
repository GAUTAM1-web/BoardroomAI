APP_ENV=development
LOG_LEVEL=INFO
DEPLOYMENT_TARGET=local
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
SESSION_SECRET=development-session-secret-change-before-production
SESSION_COOKIE_NAME=boardroom_session
SESSION_TTL_SECONDS=604800
AUTH_EMAIL_ENABLED=true
AUTH_DEMO_ENABLED=true
AUTH_GUEST_ENABLED=true
OAUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
DEMO_CONTENT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http: https: ws: wss:
CSRF_PROTECTION_ENABLED=false
DISTRIBUTED_SESSIONS_ENABLED=true
SHARED_CACHE_TTL_SECONDS=300
JOB_QUEUE_BACKEND=redis
JOB_DEFAULT_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=3
BOARDROOMAI_PLUGIN_MODULES=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=boardroom_ai
POSTGRES_USER=boardroom
POSTGRES_PASSWORD=boardroom_dev_password
DATABASE_URL=postgresql+asyncpg://boardroom:boardroom_dev_password@postgres:5432/boardroom_ai

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

BUSINESS_DATA_MODE=demo
MAPS_PROVIDER=osm_nominatim
PLACES_PROVIDER=osm_nominatim
WEATHER_PROVIDER=open_meteo
NEWS_PROVIDER=gdelt_doc
CURRENCY_PROVIDER=frankfurter
GOVERNMENT_DATA_PROVIDER=world_bank
DEMOGRAPHICS_PROVIDER=world_bank
MAPS_API_KEY=
PLACES_API_KEY=
GDELT_API_KEY=
LIVE_DATA_CACHE_TTL_SECONDS=900
LIVE_DATA_TIMEOUT_SECONDS=2.5
CURRENCY_BASE=USD
CURRENCY_QUOTES=EUR,GBP,INR
PROVIDER_USER_AGENT=BoardroomAI/1.0-local-development

API_INTERNAL_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_GITHUB_URL=
