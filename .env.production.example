APP_ENV=production
LOG_LEVEL=INFO
DEPLOYMENT_TARGET=auto
PUBLIC_FRONTEND_URL=https://your-frontend.example.com
PUBLIC_API_URL=https://your-api.example.com
FRONTEND_BASE_URL=https://your-frontend.example.com

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/boardroom_ai
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
QDRANT_URL=https://your-qdrant.example.com

AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=boardroom_session
SESSION_TTL_SECONDS=604800
AUTH_EMAIL_ENABLED=true
AUTH_DEMO_ENABLED=true
AUTH_GUEST_ENABLED=true
OAUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
DEMO_CONTENT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
SECURITY_HEADERS_ENABLED=true

BUSINESS_DATA_MODE=demo
MAPS_PROVIDER=osm_nominatim
PLACES_PROVIDER=osm_nominatim
WEATHER_PROVIDER=open_meteo
NEWS_PROVIDER=gdelt_doc
CURRENCY_PROVIDER=frankfurter
GOVERNMENT_DATA_PROVIDER=world_bank
DEMOGRAPHICS_PROVIDER=world_bank
MAPS_API_KEY=
PLACES_API_KEY=
GDELT_API_KEY=
LIVE_DATA_CACHE_TTL_SECONDS=900
LIVE_DATA_TIMEOUT_SECONDS=2.5
CURRENCY_BASE=USD
CURRENCY_QUOTES=EUR,GBP,INR
PROVIDER_USER_AGENT=BoardroomAI/1.0-production

API_INTERNAL_BASE_URL=https://your-api.example.com
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
NEXT_PUBLIC_WS_BASE_URL=wss://your-api.example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/boardroomai
