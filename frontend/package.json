{
  "name": "boardroom-ai-frontend",
  "version": "1.0.0-rc.1",
  "description": "Boardroom AI founder operating workspace and desktop shell.",
  "author": "Boardroom AI",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:icons": "node scripts/generate-icons.mjs",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:pack": "npm run desktop:icons && npm run build && electron-builder --config electron-builder.yml --win nsis portable",
    "desktop:dir": "npm run desktop:icons && npm run build && electron-builder --config electron-builder.yml --dir",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.51.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
